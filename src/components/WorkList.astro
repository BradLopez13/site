---
import type { CollectionEntry } from 'astro:content';

interface Props {
	work: CollectionEntry<'work'>[];
}

const { work } = Astro.props;
---

<ul class="list">
	{
		work.map(({ id, data }) => (
			<li>
				<a href={`/work/${id}/`}>{data.title}</a>
				{data.draft && <span class="draft">draft</span>}
				{data.kind === 'company' && !data.cleared && <span class="draft">not cleared</span>}
				<p class="meta">
					{data.kind === 'company' ? `${data.company} · ${data.role}` : data.period} · {data.summary}
				</p>
				{data.kind === 'project' && (
					<p class="meta">
						<a href={data.demo}>Live demo</a> · <a href={data.repo}>Repository</a> · {data.hard}
					</p>
				)}
			</li>
		))
	}
</ul>
