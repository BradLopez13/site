---
// Two systems, two vocabularies: the shape of an integration problem at a glance.
interface Props {
	left: string;
	right: string;
	leftWords: string[];
	rightWords: string[];
}
const { left, right, leftWords, rightWords } = Astro.props;
---

<div class="vocab card">
	<div class="stack" style="--gap: 0.75rem">
		<strong>{left}</strong>
		<div class="row" style="--gap: 0.5rem">{leftWords.map((w, i) => <span class="pill pill-fog float" style={`animation-delay: ${i * 0.4}s`}>{w}</span>)}</div>
	</div>
	<span class="neq beat" aria-hidden="true">≠</span>
	<div class="stack" style="--gap: 0.75rem">
		<strong>{right}</strong>
		<div class="row" style="--gap: 0.5rem">{rightWords.map((w, i) => <span class="pill dark-pill float" style={`animation-delay: ${0.2 + i * 0.4}s`}>{w}</span>)}</div>
	</div>
</div>

<style>
	.vocab {
		display: grid;
		gap: 1.25rem;
		align-items: center;
	}
	@media (min-width: 56.25em) {
		.vocab {
			grid-template-columns: minmax(0, 1fr) 6.25rem minmax(0, 1fr);
		}
	}
	.neq {
		display: inline-block;
		justify-self: center;
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 3rem;
		color: var(--violet);
	}
	.dark-pill {
		background: var(--ink);
		color: var(--paper);
	}
</style>
