---
import { SITE_TITLE } from '../consts';
import { base, dict, langFromUrl, switchPath } from '../i18n';

const lang = langFromUrl(Astro.url);
const t = dict(lang);
const b = base(lang);
const other = lang === 'en' ? 'es' : 'en';
const links = [
	{ href: `${b}/work/`, label: t.nav.work },
	{ href: `${b}/writing/`, label: t.nav.writing },
	{ href: `${b}/about/`, label: t.nav.about },
];
const path = Astro.url.pathname;
const current = (href: string) => path.startsWith(href);
const switchHref = switchPath(path, other);
---

<header class="wrap site-header">
	<a class="brand" href={`${b}/`}>{SITE_TITLE}</a>
	<nav aria-label={t.nav.main} class="nav-wide">
		{
			links.map((l) => (
				<a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>
					{l.label}
				</a>
			))
		}
		<a class="lang" href={switchHref} hreflang={other} lang={other} aria-label={t.meta.otherLangLabel}>{other.toUpperCase()}</a>
		<a class="play" href={`${b}/#play`}>{t.nav.play}</a>
	</nav>
	<div class="small-nav">
		<a class="lang" href={switchHref} hreflang={other} lang={other} aria-label={t.meta.otherLangLabel}>{other.toUpperCase()}</a>
		<details class="nav-menu">
			<summary aria-label={t.nav.menu}>
				<svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
					><path d="M0 1h18M0 11h18"></path></svg
				>
			</summary>
			<nav aria-label={t.nav.main}>
				{
					links.map((l) => (
						<a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>
							{l.label}
						</a>
					))
				}
				<a href={`${b}/#play`}>{t.nav.play}</a>
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-block: 1.25rem;
		position: relative;
		z-index: 10;
	}
	.brand {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
		text-decoration: none;
	}
	.nav-wide {
		display: none;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
	}
	.nav-wide a {
		padding: 0.625rem 1rem;
		border-radius: 99em;
		text-decoration: none;
	}
	.nav-wide a[aria-current='page'] {
		background: var(--white);
	}
	.nav-wide .play {
		background: var(--ink);
		color: var(--paper);
	}
	.nav-wide .play:hover {
		color: var(--violet-soft);
	}
	.lang {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.75rem;
		min-height: 2.75rem;
		border: 0.125rem solid currentColor;
		border-radius: 99em;
		font-weight: 700;
		font-size: 0.875rem;
		letter-spacing: 0.04em;
		text-decoration: none;
	}
	.small-nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.nav-menu summary {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 99em;
		background: var(--ink);
		color: var(--paper);
		cursor: pointer;
		list-style: none;
	}
	.nav-menu summary::-webkit-details-marker {
		display: none;
	}
	.nav-menu nav {
		position: absolute;
		right: var(--gutter);
		top: 4.5rem;
		display: flex;
		flex-direction: column;
		min-width: 13.75rem;
		padding: 0.5rem;
		border-radius: 1.25rem;
		background: var(--ink);
		color: var(--paper);
		box-shadow: 0 1.25rem 2.5rem rgb(0 0 0 / 0.25);
	}
	.nav-menu nav a {
		padding: 0.875rem 1rem;
		border-radius: 0.75rem;
		font-weight: 700;
		text-decoration: none;
	}
	.nav-menu nav a[aria-current='page'] {
		background: var(--ink-2);
	}
	@media (min-width: 56em) {
		.nav-wide {
			display: flex;
		}
		.small-nav {
			display: none;
		}
	}
</style>
