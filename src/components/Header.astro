---
import { LINKS } from '../consts';
import T from './T.astro';

interface Props {
	current?: 'projects' | 'work' | 'about' | 'writing';
}
const { current } = Astro.props;
const items = [
	{ href: '/#mine', key: 'nav.projects', id: 'projects' },
	{ href: '/my-work/', key: 'nav.work', id: 'work' },
	{ href: '/about/', key: 'nav.about', id: 'about' },
	{ href: '/writing/', key: 'nav.writing', id: 'writing' },
] as const;
const ico = (path: string, cls: string) => `<svg class="ico ${cls}" width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="${path}"/></svg>`;
const SUN = 'M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z';
const MOON = 'M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.36A88,88,0,0,1,65.64,67.09,89,89,0,0,1,96,49.27a104.06,104.06,0,0,0,110.73,110.73A89,89,0,0,1,188.9,190.36Z';
const AUTO = 'M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm8,16.37a88,88,0,0,1,0,175.26Z';
---

<header class="top">
	<div class="wrap">
		<a class="brand" href="/">Brad López</a>
		<nav class="nav" data-i18n-attr="aria-label:ui.mainNav" aria-label="Main">
			{items.map((i) => <T k={i.key} as="a" class="opt" href={i.href} aria-current={current === i.id ? 'page' : undefined} />)}
			<button class="lang" type="button" data-lang-toggle data-i18n-attr="aria-label:ui.langSwitch" aria-label="Leer en español">
				<T k="ui.langShort" />
			</button>
			<button
				class="theme-btn"
				type="button"
				data-theme-toggle
				data-l-auto="ui.themeAuto"
				data-l-light="ui.themeLight"
				data-l-dark="ui.themeDark"
				data-i18n-attr="aria-label:ui.themeAuto"
				aria-label="Theme: system. Switch to light"
				set:html={ico(SUN, 'i-light') + ico(MOON, 'i-dark') + ico(AUTO, 'i-auto')}
			/>
			<a class="btn btn-ink btn-sm" href={`mailto:${LINKS.email}`}><T k="ui.writeMe" /></a>
		</nav>
	</div>
</header>
