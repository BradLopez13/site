---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	articles: CollectionEntry<'writing'>[];
}

const { articles } = Astro.props;
---

{
	articles.length === 0 ? (
		<p>The first article is on its way.</p>
	) : (
		<ul class="list">
			{articles.map((article) => (
				<li>
					<a href={`/writing/${article.id}/`}>{article.data.title}</a>
					{article.data.draft && <span class="draft">draft</span>}
					<p class="meta">
						<FormattedDate date={article.data.pubDate} /> · {article.data.description}
					</p>
				</li>
			))}
		</ul>
	)
}
