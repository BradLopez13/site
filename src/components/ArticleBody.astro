---
// One language version of an article: an index of its sections beside the text on wide screens,
// so the page uses its width while every line stays readable.
import type { MarkdownHeading } from 'astro';
import { LINKS } from '../consts';
import { articles } from '../data/articles';
import { dict, type Lang } from '../i18n';

interface Props {
	lang: Lang;
	title: string;
	description: string;
	headings: MarkdownHeading[];
	slug: string;
	only?: Lang;
}
const { lang, title, description, headings, slug, only } = Astro.props;
const d = dict(lang);
const sections = headings.filter((h) => h.depth === 2);
// Only Reservas is public code; what comes from the team links nowhere.
const fromReservas = articles.find((x) => x.slug === slug)?.from === 'reservas';
---

<div lang={lang} data-only={only}>
	<header class="article-head">
		<h1 class="disp h-l">{title}</h1>
		<p class="lede mt-4">{description}</p>
	</header>
	<div class="article-grid">
		<aside class="toc" aria-label={d.article.contents}>
			<p class="toc-title">{d.article.contents}</p>
			<ol class="toc-list">
				{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
			</ol>
			{fromReservas && <a class="toc-repo" href={LINKS.reservasRepo}>{d.article.repo}</a>}
		</aside>
		<div class="article">
			<slot />
			<nav class="series-nav" aria-label={d.article.more}>
				<h2 class="disp h-s">{d.article.more}</h2>
				<ol class="toc-list toc-series">
					{
						articles.map((x) => (
							<li>
								<a href={`/writing/${x.slug}/`} aria-current={x.slug === slug ? 'page' : undefined}>
									<span class="n">{d.writing.from[x.from]}</span>
									{d.writing[x.key]}
								</a>
							</li>
						))
					}
				</ol>
			</nav>
		</div>
	</div>
</div>
