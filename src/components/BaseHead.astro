---
// Global styles for every page.
import '../styles/global.css';
import '../styles/islands.css';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import { base, langFromUrl, switchPath } from '../i18n';

interface Props {
	title: string;
	description: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const lang = langFromUrl(Astro.url);
// The same page in each language, so search engines pair them.
const alternates = (['en', 'es'] as const).map((l) => ({ l, href: new URL(switchPath(Astro.url.pathname, l), Astro.site) }));

const { title, description } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(`${base(lang)}/rss.xml`, Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-display" preload />
<Font cssVariable="--font-body" preload />
<Font cssVariable="--font-mono" />
<meta name="theme-color" content="#e4e6ea" />
<!-- Motion starts hidden only when JS runs and the visitor allows motion (animacion-ui rule 6). -->
<script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('js')</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={alternates[0].href} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
