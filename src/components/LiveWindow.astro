---
// A deployed app behind its poster: the iframe loads only when the visitor asks, says when it is loading,
// says when it takes too long, and can go back to the poster.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { t, type Key } from '../i18n';
import T from './T.astro';

interface Props {
	url: string;
	name: string;
	shot: ImageMetadata;
	altKey: Key;
	titleKey: Key;
	noteKey: Key;
	/** Note shown once the app is live (how far it works inside the page). */
	noteOnKey?: Key;
}
const { url, name, shot, altKey, titleKey, noteKey, noteOnKey } = Astro.props;
const host = new URL(url).host;
---

<div class="live" data-live={url} data-title={t(titleKey)}>
	<div class="live-bar">
		<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
		<span class="url">{host}</span>
		<button class="live-back" type="button" hidden><T k="ui.backToShot" /></button>
		<a href={url}><T k="ui.open" /><span class="visually-hidden"> {name}</span><svg class="ico" width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"></path></svg></a>
	</div>
	<div class="live-view">
		<Image src={shot} alt={t(altKey)} data-i18n-attr={`alt:${altKey}`} widths={[640, 960, 1280]} sizes="(min-width: 60em) 52vw, 100vw" />
		<button class="btn btn-accent load-btn" type="button"><T k="ui.useLive" /><span class="visually-hidden"> {name}</span></button>
		<p class="live-status" role="status" hidden><T k="ui.loadingLive" data-loading /><T k="ui.liveFail" data-fail hidden /></p>
	</div>
</div>
<T k={noteKey} as="p" class="live-note muted" data-on={noteOnKey} />
