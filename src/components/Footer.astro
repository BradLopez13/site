---
import { LINKS, SITE_TITLE } from '../consts';
---

<footer>
	<p>{SITE_TITLE}</p>
	<p class="links">
		<a href={LINKS.github}>GitHub</a>
		<a href={LINKS.linkedin}>LinkedIn</a>
		<a href="/rss.xml">RSS</a>
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0;
	}
	.links {
		display: flex;
		justify-content: center;
		gap: 1em;
	}
	.links a {
		color: rgb(var(--gray));
	}
	.links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
