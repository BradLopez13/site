---
import { LINKS } from '../consts';
import type { Key } from '../i18n';
import T from './T.astro';

interface Props {
	leadKey?: Key;
}
const { leadKey = 'footer.lead' } = Astro.props;
const [user, domain] = LINKS.email.split('@');
---

<footer class="band foot">
	<div class="wrap">
		<T k={leadKey} as="p" class="muted" style="margin:0 0 1.25rem;font-size:1.15rem;max-width:44ch" />
		<a class="mail" href={`mailto:${LINKS.email}`}>{user}@<wbr />{domain}</a>
		<nav class="foot-nav" data-i18n-attr="aria-label:ui.footerNav" aria-label="Site">
			<T k="nav.projects" as="a" href="/#mine" />
			<T k="nav.work" as="a" href="/my-work/" />
			<T k="nav.about" as="a" href="/about/" />
			<T k="nav.writing" as="a" href="/writing/" />
		</nav>
		<div class="foot-row">
			<T k="footer.place" class="muted" />
			<span class="links">
				<button class="btn btn-line btn-sm" type="button" data-copy={LINKS.email} hidden><T k="ui.copyEmail" /></button>
				<a href={LINKS.github}>GitHub</a>
				<a href={LINKS.linkedin}>LinkedIn</a>
			</span>
		</div>
	</div>
</footer>
