---
// Test output, one line per entry. "✓ " lines get a green tick, "… " lines are muted.
interface Props {
	caption: string;
	lines: string[];
}
const { caption, lines } = Astro.props;
---

<figure class="code">
	<figcaption><span>{caption}</span></figcaption>
	<pre class="typelines">{
		lines.map((l) =>
			l.startsWith('✓ ') ? (
				<span>
					<span class="tick">✓</span>
					{l.slice(1)}
					{'\n'}
				</span>
			) : l.startsWith('… ') ? (
				<span class="dim">
					{l}
					{'\n'}
				</span>
			) : (
				<span>
					{l}
					{'\n'}
				</span>
			),
		)
	}</pre>
</figure>

<style>
	.tick {
		color: var(--ok);
	}
	.dim {
		color: #a99c95;
	}
</style>
