---
import { dict, langFromUrl } from '../i18n';

interface Props {
	items: { title: string; why: string; rejected?: string }[];
}
const { items } = Astro.props;
const c = dict(langFromUrl(Astro.url)).common;
---

<div class="accordion" data-stagger="up" style={`--why: "${c.why}"; --close: "${c.close}"`}>
	{
		items.map((d) => (
			<details>
				<summary>
					<h3>{d.title}</h3>
				</summary>
				<div class:list={['body', { two: d.rejected }]}>
					<p>{d.why}</p>
					{d.rejected && <p class="muted">{c.rejected} {d.rejected}</p>}
				</div>
			</details>
		))
	}
</div>
