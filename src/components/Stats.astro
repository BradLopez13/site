---
// Stacked in a case-study sidebar on desktop, side by side everywhere else.
interface Props {
	items: { value: string; label: string; tone?: 'ok' }[];
}
const { items } = Astro.props;
---

<div class="stats" data-stagger="up">
	{
		items.map((s) => (
			<div class="card stat">
				<strong class:list={{ ok: s.tone === 'ok' }}>{s.value}</strong>
				<span>{s.label}</span>
			</div>
		))
	}
</div>

<style>
	.stats {
		display: grid;
		gap: 0.625rem;
		grid-template-columns: repeat(auto-fit, minmax(6.25rem, 1fr));
	}
	@media (min-width: 60em) {
		:global(.side) .stats {
			grid-template-columns: 1fr;
		}
	}
	.ok {
		color: var(--ok-text) !important;
	}
</style>
