---
// The reservas race test as a still-moving picture, the proof that opens the home's backend band.
// CSS only, so it plays before any island hydrates.
// Fifty lanes, as in the real test, drawn as bars that grow from the start line: every one hits
// the wall and falls back except one, which runs on into the slot. Under reduced motion it rests
// on that final frame. The pause control is a plain checkbox read by :has(), so it stops every
// looping animation on the page even without JS; its name never changes, its checked state does.
// The track speaks plain words for visitors who do not know the test: who starts, where the
// database stands, who gets the court. Each status slip carries a gloss for the same reason.
// The panel is the picture and its result: the caption and the link to the test sit with the
// headline on the page, and the retry lesson lives in the backend tour's "Sent twice?" stop.

interface Props {
	win: string;
	lose: string;
	winGloss: string;
	loseGloss: string;
	start: string;
	wall: string;
	gets: string;
	sr: string;
	pause: string;
}

const { win, lose, winGloss, loseGloss, start, wall, gets, sr, pause } = Astro.props;
const lanes = 50;
const winner = 23;
---

<figure class="race-proof dark" data-a="up" style="--d: 300ms">
	<div class="race-stage" aria-hidden="true">
		<div class="race-labels">
			<span>{start}</span>
			<span class="race-wall-label">{wall}</span>
		</div>
		<div class="race-track proof-track" style={`--lanes: ${lanes}; --slot: clamp(8.5rem, 32cqw, 10rem)`}>
			{
				Array.from({ length: lanes }, (_, i) => (
					<div
						class:list={['lane', i === winner ? 'win' : 'refuse']}
						style={`top: calc(${i} * var(--pitch)); --d: ${i === winner ? 0 : (((i * 17) % 7) * 0.02).toFixed(2)}s`}
					>
						<span />
					</div>
				))
			}
			<div class="race-wall"></div>
			<div class="race-slot"><b>201</b>{gets}</div>
		</div>
	</div>
	<figcaption>
		<span class="sr-only">{sr}</span>
		<span class="race-result">
			<span class="slip"><code class="r-win">{win}</code> <span class="gloss">{winGloss}</span></span>
			<span class="slip"><code class="r-lose">{lose}</code> <span class="gloss">{loseGloss}</span></span>
		</span>
		<!-- Quiet, in the panel's corner: it pauses every loop on the page, but it belongs to the one
		     picture that moves most. Paused shows twice over: the selected fill and a play glyph. -->
		<label class="pause">
			<input type="checkbox" id="pause-motion" />
			<svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1" /><rect x="9.5" y="2" width="3.5" height="12" rx="1" /></svg>
			<svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11a.75.75 0 0 0 1.13.65l9-5.5a.75.75 0 0 0 0-1.3l-9-5.5A.75.75 0 0 0 4 2.5z" /></svg>
			<span>{pause}</span>
		</label>
	</figcaption>
</figure>

<style>
	.race-proof {
		margin: 0;
		display: grid;
		gap: 1rem;
		padding: clamp(1rem, 2.4vw, 1.75rem) clamp(1rem, 3vw, 2.25rem);
		border-radius: 1.5rem;
		background: var(--ink);
		color: var(--paper);
	}
	/* The labels and the track share one container, so the wall label lines up with the wall:
	   its column starts exactly where the wall stands (100% minus the slot minus 1rem). */
	.race-stage {
		--slot: clamp(8.5rem, 32cqw, 10rem);
		container-type: inline-size;
		display: grid;
		gap: 0.5rem;
	}
	.race-labels {
		display: grid;
		grid-template-columns: minmax(0, 1fr) calc(var(--slot) + 1rem);
		align-items: end;
		gap: 0;
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--muted-on-ink);
	}
	.race-labels > :first-child {
		padding-right: 0.75rem;
	}
	.race-wall-label {
		padding-left: 0.5rem;
		border-left: 0.25rem solid var(--paper);
		color: var(--paper);
	}
	/* Fifty lanes thick enough to count, on a shorter loop than the case-study race: the proof
	   spends its time on the result, not on the wait. */
	.proof-track {
		--pitch: clamp(0.375rem, 0.9vw, 0.5rem);
		height: calc(var(--lanes) * var(--pitch));
	}
	/* On a phone-width panel the fifty lanes pack tighter, so the race stays a picture you take in
	   at once instead of a tall block of stripes. */
	@container (max-width: 30rem) {
		.proof-track {
			--pitch: 0.3rem;
		}
	}
	.proof-track :global(.lane),
	.proof-track :global(.lane span) {
		height: calc(var(--pitch) * 0.6);
		animation-duration: 6s;
	}
	/* Bars, not dashes: each lane is drawn from the start line and revealed with clip-path, so at
	   rest the panel is full of refused requests stopped at the wall and one green bar in the slot. */
	.proof-track :global(.lane) {
		width: calc(var(--w) + 1.25rem);
	}
	.proof-track :global(.lane span) {
		width: 100%;
	}
	.proof-track :global(.lane.refuse) {
		animation-name: k-proof-refuse;
	}
	.proof-track :global(.lane.win) {
		width: calc(var(--w) + 5rem);
		animation-name: k-proof-win;
	}
	.proof-track :global(.lane.win),
	.proof-track :global(.lane.win span) {
		height: calc(var(--pitch) * 0.9);
	}
	@keyframes k-proof-refuse {
		0% {
			clip-path: inset(0 100% 0 0);
			opacity: 1;
		}
		16% {
			clip-path: inset(0 0 0 0);
			opacity: 1;
		}
		21%,
		82% {
			clip-path: inset(0 2.25rem 0 0);
			opacity: 0.4;
		}
		92%,
		100% {
			clip-path: inset(0 2.25rem 0 0);
			opacity: 0;
		}
	}
	@keyframes k-proof-win {
		0% {
			clip-path: inset(0 100% 0 0);
			opacity: 1;
		}
		22%,
		88% {
			clip-path: inset(0 0 0 0);
			opacity: 1;
		}
		96%,
		100% {
			clip-path: inset(0 0 0 0);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.proof-track :global(.lane) {
			animation: none;
			transform: none;
			opacity: 0.4;
			clip-path: inset(0 2.25rem 0 0);
		}
		.proof-track :global(.lane.win) {
			opacity: 1;
			clip-path: none;
		}
	}
	.proof-track :global(.race-slot) {
		flex-direction: column;
		align-items: flex-end;
		justify-content: center;
		gap: 0.125rem;
	}
	.proof-track :global(.race-slot) {
		font-size: 0.875rem;
	}
	.proof-track :global(.race-slot b) {
		font-family: var(--font-mono);
		font-size: 1rem;
	}
	.race-proof figcaption {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}
	.race-result {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
	}
	/* The code stays on one line; on a narrow panel the gloss wraps below it instead. */
	.slip {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
	}
	.slip code {
		white-space: nowrap;
	}
	.gloss {
		font-size: 0.875rem;
		color: var(--muted-on-ink);
	}
	.race-result code {
		padding: 0.25rem 0.625rem;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--ink);
	}
	.r-win {
		background: var(--ok);
	}
	.r-lose {
		background: var(--warn);
	}
	/* The corner of the panel: pushed right on its row, even when it wraps below the slips. */
	.pause {
		margin-inline-start: auto;
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0 1rem;
		border: 0.125rem solid var(--line-on-ink);
		border-radius: 99em;
		font-size: 0.875rem;
		font-weight: 700;
		cursor: pointer;
	}
	.pause:hover {
		border-color: var(--violet-soft);
	}
	/* Paused reads as pressed: the same violet fill as every selected control. */
	.pause:has(input:checked) {
		border-color: var(--violet);
		background: var(--violet);
		color: var(--white);
	}
	.pause input {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		cursor: pointer;
	}
	.pause:has(input:focus-visible) {
		outline: 0.1875rem solid var(--violet-soft);
		outline-offset: 0.1875rem;
	}
	.pause svg {
		width: 0.875rem;
		height: 0.875rem;
		fill: currentColor;
	}
	.pause .i-play,
	.pause:has(input:checked) .i-pause {
		display: none;
	}
	.pause:has(input:checked) .i-play {
		display: block;
	}
	/* Nothing loops under reduced motion, so there is nothing to pause. */
	@media (prefers-reduced-motion: reduce) {
		.pause {
			display: none;
		}
	}
	/* Every animation that repeats, wherever it sits on the page: the race lanes, the screenshot
	   pan, the flow arrows, the beat and float accents and the step loops. */
	:global(html:has(#pause-motion:checked) :is(.lane, .lane span, .pan, .flow, .beat, .float, .step)) {
		animation-play-state: paused !important;
	}
	/* Paused, the race shows its result, never a half-faded frame: the same rest frame as
	   reduced motion, 49 bars stopped at the wall and the green one in the slot. */
	:global(html:has(#pause-motion:checked)) .proof-track :global(.lane) {
		animation: none;
		opacity: 0.4;
		clip-path: inset(0 2.25rem 0 0);
	}
	:global(html:has(#pause-motion:checked)) .proof-track :global(.lane.win) {
		opacity: 1;
		clip-path: none;
	}
</style>
