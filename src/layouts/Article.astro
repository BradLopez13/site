---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import Split from '../components/Split.astro';
import { series } from '../data/series';
import { base, dict, fmt, langFromUrl } from '../i18n';
import Base from './Base.astro';
import brad from '../assets/brad.jpg';

type Props = CollectionEntry<'writing'>['data'];

const { title, description, pubDate, updatedDate, part, draft } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = dict(lang);
const next = part ? series.find((s) => s.part === part + 1) : undefined;
---

<Base title={title} description={description}>
	<header class="wrap art-head">
		{part && <span class="pill">{fmt(t.article.part, { n: part, total: series.length })}</span>}
		{draft && <span class="pill draft">{t.common.draft}</span>}
		<Split as="h1" text={title} class="art-title" delay={150} />
		<div class="row byline" data-a="up" style="--d: 400ms">
			<Image src={brad} alt="" width={44} height={44} class="avatar" />
			<span>
				<strong>Brad López</strong>, <FormattedDate date={pubDate} />
				{updatedDate && <>, {t.article.updated} <FormattedDate date={updatedDate} /></>}
			</span>
		</div>
	</header>

	<div class="wrap art-body">
		<div class="prose">
			<slot />
		</div>
	</div>

	<section class="wrap section next" data-stagger="up">
		<a href={`${base(lang)}/#play`} class="cta-article">
			<span>{t.article.tryIt}</span>
			<strong>{t.article.tryItTitle}</strong>
		</a>
		{
			next && (
				<div class="card stack" style="--gap: 0.5rem">
					<span class="muted">{t.article.next}</span>
					<strong class="next-title">{t.series.parts[next.part - 1]}</strong>
				</div>
			)
		}
	</section>
</Base>

<style>
	.art-head {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		text-align: center;
		padding-block: clamp(1.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
	}
	.art-head :global(.art-title) {
		max-width: 22ch;
		font-weight: 900;
		font-size: clamp(1.875rem, 5vw, 4.5rem);
		line-height: 1.04;
		letter-spacing: -0.03em;
	}
	.draft {
		background: var(--warn);
	}
	.byline {
		justify-content: center;
		font-size: 1rem;
	}
	.byline :global(.avatar) {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		object-fit: cover;
		object-position: 50% 30%;
	}
	.art-body {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.art-body :global(.prose) {
		width: 100%;
	}
	.art-body :global(.wide) {
		width: min(81.25rem, calc(100vw - 2 * var(--gutter)));
		max-width: none;
		align-self: center;
		margin-block: 1.5rem;
	}
	.next {
		display: grid;
		gap: 1rem;
	}
	@media (min-width: 56.25em) {
		.next {
			grid-template-columns: 1fr 1fr;
		}
	}
	.next-title {
		font-family: var(--font-display);
		font-size: clamp(1.125rem, 2vw, 1.625rem);
		line-height: 1.25;
	}
</style>
