---
import type { CollectionEntry } from 'astro:content';
import Split from '../components/Split.astro';
import { base, dict, langFromUrl } from '../i18n';
import Base from './Base.astro';

type Props = CollectionEntry<'work'>['data'];

const data = Astro.props;
const company = data.kind === 'company';
const lang = langFromUrl(Astro.url);
const t = dict(lang);
---

<Base title={data.title} description={data.summary}>
	<section class="wrap case-hero">
		<div class="stack" style="--gap: 1.375rem">
			<a href={`${base(lang)}/work/`} class="back">{t.common.allWork}</a>
			{data.draft && <span class="badge draft">{t.common.draft}</span>}
			{company && !data.cleared && <span class="badge draft">{t.case.notCleared}</span>}
			<Split text={data.title} as="h1" mode={company ? 'blur' : 'rot'} class:list={['display-xl', { long: company }]} delay={150} />
			<p class="lede" data-a="up" style="--d: 300ms">{data.tagline}</p>
		</div>
		<dl class="card facts" data-a="right" style="--d: 400ms">
			{company && (<><dt>{t.case.where}</dt><dd>{data.where}</dd></>)}
			<dt>{t.case.role}</dt>
			<dd>{data.role}</dd>
			<dt>{t.case.when}</dt>
			<dd>{data.period}</dd>
			<dt>{t.case.stack}</dt>
			<dd>{data.stack.join(', ')}</dd>
			{
				data.kind === 'project' && (
					<>
						<dt>{t.case.links}</dt>
						<dd class="row" style="--gap: 1rem">
							<a href={data.demo}>{t.common.liveDemo}</a>
							<a href={data.repo}>{t.common.repository}</a>
						</dd>
					</>
				)
			}
		</dl>
	</section>
	<slot />
	<div class="section"></div>
</Base>

<style>
	.case-hero {
		display: grid;
		gap: 2rem 4rem;
		align-items: end;
		padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4.5rem);
	}
	@media (min-width: 62.5em) {
		.case-hero {
			grid-template-columns: minmax(0, 1fr) 25rem;
		}
	}
	.back {
		font-weight: 700;
	}
	.badge {
		align-self: flex-start;
		padding: 0.375rem 0.875rem;
		border-radius: 99em;
		background: var(--violet);
		color: var(--white);
		font-weight: 700;
		font-size: 0.875rem;
	}
	.badge.draft {
		background: var(--warn);
		color: var(--ink);
	}
	.long {
		font-size: clamp(2rem, 5vw, 4.5rem);
		line-height: 1.02;
	}
	.facts {
		margin: 0;
		display: grid;
		grid-template-columns: 5.625rem minmax(0, 1fr);
		gap: 0.75rem;
		font-size: 1rem;
		line-height: 1.45;
	}
	.facts dt {
		font-weight: 700;
	}
	.facts dd {
		margin: 0;
	}
</style>
