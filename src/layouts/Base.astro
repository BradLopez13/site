---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	footerLead?: string;
}

const { title, description = SITE_DESCRIPTION, footerLead } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title ? `${title} · ${SITE_TITLE}` : SITE_TITLE} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer lead={footerLead} />
		<script>
			// Plays each entrance once, when its block scrolls into view.
			const selector = '[data-a], [data-stagger], .split, .drawx, .typelines, .stack3d';
			if (document.documentElement.classList.contains('js')) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add('in');
								io.unobserve(e.target);
							}
						}
					},
					{ rootMargin: '0% 0% -10% 0%' },
				);
				document.querySelectorAll(selector).forEach((el) => io.observe(el));
			}
		</script>
	</body>
</html>

<style>
	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
</style>
