---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { dict, langFromUrl } from '../i18n';

interface Props {
	title?: string;
	description?: string;
	footerLead?: string;
}

const lang = langFromUrl(Astro.url);
const { title, description = dict(lang).meta.description, footerLead } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · ${dict(lang).meta.role}`} description={description} />
	</head>
	<body>
		<a class="skip" href="#main">{dict(lang).common.skip}</a>
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer lead={footerLead} />
		<script>
			// Plays each entrance once, as its block is about to scroll into view: the margin reaches 10%
			// below the fold, so a tall block (the race panel) has started before the visitor arrives
			// and a fast scroll never lands on an empty band.
			const selector = '[data-a], [data-stagger], .split, .drawx, .typelines, .stack3d';
			if (document.documentElement.classList.contains('js')) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add('in');
								io.unobserve(e.target);
							}
						}
					},
					{ rootMargin: '0% 0% 10% 0%', threshold: 0 },
				);
				document.querySelectorAll(selector).forEach((el) => io.observe(el));
			}
		</script>
	</body>
</html>

<style>
	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
</style>
