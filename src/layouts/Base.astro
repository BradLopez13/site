---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import T from '../components/T.astro';
import { flat, t, type Key } from '../i18n';

interface Props {
	titleKey?: Key;
	descriptionKey?: Key;
	/** A literal title (an article's own title), used when no key fits. */
	title?: string;
	current?: 'projects' | 'work' | 'about' | 'writing';
	footerKey?: Key;
}

const { titleKey = 'meta.title', descriptionKey = 'meta.description', title, current, footerKey } = Astro.props;
// The Spanish texts, applied synchronously at the end of the body when the visitor reads Spanish,
// before the first paint; the bundled i18n script takes over for later switches.
const es = JSON.stringify(flat('es'));
---

<!doctype html>
<html lang="en" data-lang="en" data-theme="auto">
	<head>
		<BaseHead title={title ?? t(titleKey)} description={t(descriptionKey)} />
		<slot name="head" />
	</head>
	<body data-title-key={title ? undefined : titleKey}>
		<T k="ui.skip" as="a" class="skip" href="#main" />
		<Header current={current} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer leadKey={footerKey} />
		<script is:inline define:vars={{ es }}>
			if (document.documentElement.dataset.lang === 'es') {
				var d = JSON.parse(es);
				document.querySelectorAll('[data-i18n]').forEach(function (el) {
					var s = d[el.dataset.i18n];
					if (s == null) return;
					var v = el.dataset.i18nVars ? JSON.parse(el.dataset.i18nVars) : {};
					el.textContent = s.replace(/\{(\w+)\}/g, function (m, k) { return k in v ? v[k] : m; });
				});
				document.querySelectorAll('[data-i18n-attr]').forEach(function (el) {
					el.dataset.i18nAttr.split(';').forEach(function (p) { var a = p.split(':'); if (d[a[1]] != null) el.setAttribute(a[0], d[a[1]]); });
				});
			}
		</script>
		<script>
			import '../scripts/i18n';
			import '../scripts/motion';
		</script>
	</body>
</html>
