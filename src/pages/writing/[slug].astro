---
// One route per article: both language versions render, and only the visitor's language shows.
import { render } from 'astro:content';
import '../../styles/islands.css';
import ArticleBody from '../../components/ArticleBody.astro';
import T from '../../components/T.astro';
import { series } from '../../data/series';
import { getArticles } from '../../lib/content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const es = await getArticles('es');
	return (await getArticles('en')).map((article) => ({
		params: { slug: article.slug },
		props: { article, translation: es.find((e) => e.slug === article.slug) },
	}));
}

const { article, translation } = Astro.props;
const { Content, headings } = await render(article);
const es = translation ? await render(translation) : null;
const Es = es?.Content;
const part = series.find((s) => s.slug === article.slug)?.part ?? 1;
---

<Base current="writing" title={`${article.data.title} · Brad López`} titleEs={translation ? `${translation.data.title} · Brad López` : undefined}>
	<article class="wrap py-[clamp(2.5rem,6vw,5rem)]">
		<a class="crumb" href="/writing/"><T k="writing.seriesCrumb" vars={{ n: part }} /></a>
		<ArticleBody lang="en" only={Es ? 'en' : undefined} title={article.data.title} description={article.data.description} headings={headings} slug={article.slug}>
			<Content />
		</ArticleBody>
		{
			Es && translation && es && (
				<ArticleBody lang="es" only="es" title={translation.data.title} description={translation.data.description} headings={es.headings} slug={article.slug}>
					<Es />
				</ArticleBody>
			)
		}
	</article>
</Base>
