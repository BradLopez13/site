---
import SeriesList from '../../components/SeriesList.astro';
import Split from '../../components/Split.astro';
import Base from '../../layouts/Base.astro';
---

<Base title="Writing" description="A series on the decisions and bugs behind reservas, each with a live demo and the commit behind it.">
	<section class="wrap section side">
		<div class="stack" style="--gap: 1rem">
			<Split as="h1" text="Writing" mode="up" class="display-xl" delay={150} />
			<p data-a="up" style="--d: 300ms">A four-part series on what it took to make reservas hold up, each with a live demo and the commit behind it.</p>
			<a href="/rss.xml" class="rss">Follow by RSS</a>
		</div>
		<SeriesList />
	</section>
</Base>

<style>
	.rss {
		font-weight: 700;
	}
</style>
