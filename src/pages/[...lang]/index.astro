---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import SeriesList from '../../components/SeriesList.astro';
import Split from '../../components/Split.astro';
import ApiGame from '../../components/islands/ApiGame';
import BackendTour from '../../components/islands/BackendTour';
import JobTiles from '../../components/islands/JobTiles';
import ScreenTabs from '../../components/islands/ScreenTabs';
import { LINKS } from '../../consts';
import { stackDaily } from '../../data/job';
import Base from '../../layouts/Base.astro';
import { base, dict, fmt, langPaths, type Lang } from '../../i18n';
import { pista } from '../../data/reservas';
import brad from '../../assets/brad.jpg';
import casinoShot from '../../assets/shots/casino-home.jpg';
import bentoShot from '../../assets/shots/reservas-bento.jpg';
import dayShot from '../../assets/shots/reservas-franjas.jpg';
import homeShot from '../../assets/shots/reservas-home.jpg';
import phoneShot from '../../assets/shots/reservas-phone.jpg';

export const getStaticPaths = langPaths;
const lang: Lang = Astro.params.lang === 'es' ? 'es' : 'en';
const t = dict(lang);
const h = t.home;
const b = base(lang);

const shot = async (src: ImageMetadata, label: string, url: string, alt: string) => {
	const img = await getImage({ src, width: 1280, format: 'webp' });
	return { label, url, alt, src: img.src, width: src.width, height: src.height };
};
const screens = await Promise.all([
	shot(homeShot, h.screens.courts.label, 'reservas-web-two.vercel.app', h.screens.courts.alt),
	shot(dayShot, h.screens.day.label, 'reservas-web-two.vercel.app/pistas/7e51…', h.screens.day.alt),
	shot(bentoShot, h.screens.grid.label, 'reservas-web-two.vercel.app', h.screens.grid.alt),
]);

// Every one of these is a real route and status of the reservas API.
const chips = [
	{ code: 201, text: 'POST /api/reservas', tone: 'ok', pos: 'left: -6%; top: 18%' },
	{ code: 409, text: 'PISTA_OCUPADA', tone: 'warn', pos: 'right: -4%; top: 44%' },
	{ code: 200, text: 'GET /api/pistas/:id/franjas', tone: 'ok', pos: 'left: -2%; top: 68%' },
	{ code: 204, text: 'DELETE /api/reservas/:id', tone: 'ok', pos: 'right: 0; top: 8%' },
	{ code: 503, text: 'CONTENCION', tone: 'err', pos: 'left: 6%; top: 86%' },
	{ code: 201, text: 'POST /api/auth/registro', tone: 'ok', pos: 'right: -2%; top: 30%' },
];
---

<Base>
	<section class="wrap hero">
		<div class="stack" style="--gap: clamp(1.25rem, 3vw, 2.25rem)">
			<Split as="h1" text={h.title} class="display-xl" delay={150} />
			<p class="lede" data-a="up" style="--d: 500ms">{h.lede}</p>
			<div class="row" data-a="up" style="--d: 650ms">
				<a class="btn btn-primary" href="#play">{h.ctaPlay}</a>
				<a class="btn btn-ghost" href={`${b}/work/`}>{h.ctaWork}</a>
			</div>
		</div>
		<div class="portrait">
			<Image src={brad} alt={h.photoAlt} widths={[360, 520, 760]} sizes="(min-width: 62.5em) 30rem, 80vw" loading="eager" fetchpriority="high" data-a="clip" style="--d: 200ms" />
			{
				chips.map((c, i) => (
					<span class={`chip ${c.tone}`} style={`${c.pos}; animation-delay: ${i * 1.5}s`} aria-hidden="true">
						<b>{c.code}</b>
						{c.text}
					</span>
				))
			}
		</div>
	</section>

	<section id="work" class="band-dark dark wrap section live-band" data-a="up">
		<div class="split-head">
			<Split text={h.liveTitle} class="display-l" mode="rot" />
			<p class="muted">{h.liveLede}</p>
		</div>
		<div class="live-grid">
			<div class="live-shots">
				<ScreenTabs client:visible screens={screens} live={LINKS.reservasDemo} openLabel={t.common.openLive} tabsLabel={h.screensLabel} />
				<Image src={phoneShot} alt={h.phoneAlt} class="phone" width={180} />
			</div>
			<div class="stack" style="--gap: 1.125rem">
				<h3 class="display-m">reservas</h3>
				<p>{h.reservasDesc}</p>
				<div class="row">
					<a class="btn btn-primary" href={LINKS.reservasDemo}>{t.common.openDemo}</a>
					<a class="btn btn-ghost" href={LINKS.reservasRepo}>{t.common.code}</a>
					<a class="btn btn-ghost" href={`${b}/work/reservas/`}>{t.common.caseStudy}</a>
				</div>
			</div>
		</div>
		<div class="live-grid casino">
			<div class="stack" style="--gap: 1.125rem">
				<h3 class="display-m">casino_online</h3>
				<p>{h.casinoDesc}</p>
				<div class="row">
					<a class="btn btn-primary" href={LINKS.casinoDemo}>{t.common.openDemo}</a>
					<a class="btn btn-ghost" href={LINKS.casinoRepo}>{t.common.code}</a>
				</div>
			</div>
			<div class="frame tilt" data-a="right">
				<div class="frame-bar">
					<span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="frame-url">casino-online-nu.vercel.app/login</span>
				</div>
				<Image src={casinoShot} alt={h.casinoAlt} width={1280} class="frame-img" />
			</div>
		</div>
	</section>

	<section class="wrap section stack" style="--gap: 2.5rem">
		<div class="split-head">
			<Split text={h.backendTitle} class="display-l" mode="blur" />
			<p>{h.backendLede}</p>
		</div>
		<BackendTour client:visible lang={lang} />
	</section>

	<section class="wrap stack" style="--gap: 1.75rem; padding-bottom: clamp(3.5rem, 8vw, 8rem)">
		<div class="split-head">
			<Split text={h.workTitle} class="display-l" mode="up" />
			<p>{h.workLede}</p>
		</div>
		<JobTiles client:visible lang={lang} />
		<div class="row" style="--gap: 0.625rem" data-stagger>
			<strong>{h.everyDay}</strong>
			{stackDaily.map((s) => <span class="pill">{s}</span>)}
		</div>
		<a href={`${b}/about/`} class="more-link">{h.everything}</a>
	</section>

	<section id="play" class="wrap section play">
		<div class="stack" style="--gap: 1.25rem">
			<Split text={h.playTitle} class="display-l" mode="chars" />
			<p class="lede">{h.playLede}</p>
			<details class="more">
				<summary><span class="when-closed">{h.howOpen}</span><span class="when-open">{h.howClose}</span></summary>
				<p>{fmt(h.howRules, { court: pista.nombre, time: pista.franja })}</p>
				<p>{h.howSim}</p>
			</details>
		</div>
		<ApiGame client:visible lang={lang} />
	</section>

	<section id="writing" class="wrap section side">
		<div class="stack" style="--gap: 1rem">
			<Split text={h.writingTitle} class="display-l" mode="rot" />
			<p>{h.writingLede}</p>
			<a href={`${b}/rss.xml`} class="more-link">{t.common.rss}</a>
		</div>
		<SeriesList />
	</section>
</Base>

<style>
	.hero {
		display: grid;
		gap: 2.5rem 4rem;
		align-items: center;
		padding-block: clamp(1rem, 4vw, 3.5rem) clamp(3.5rem, 8vw, 7.5rem);
	}
	@media (min-width: 62.5em) {
		.hero {
			grid-template-columns: minmax(0, 1fr) 30rem;
		}
	}
	.portrait {
		position: relative;
		max-width: 30rem;
		width: 80%;
		justify-self: center;
	}
	.portrait :global(img) {
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 99em 99em 1.75rem 1.75rem;
	}
	.chip {
		position: absolute;
		display: flex;
		gap: 0.5rem;
		align-items: center;
		padding: 0.5rem 0.75rem;
		border-radius: 0.625rem;
		background: var(--ink);
		color: var(--paper);
		font-family: var(--font-mono);
		font-size: clamp(0.6875rem, 1vw, 0.875rem);
		white-space: nowrap;
		box-shadow: 0 0.75rem 1.875rem rgb(46 33 28 / 0.25);
	}
	.chip.ok b {
		color: var(--ok);
	}
	.chip.warn b {
		color: var(--warn);
	}
	.chip.err b {
		color: var(--err);
	}
	:global(html.js) .chip {
		opacity: 0;
		animation: k-chip 9s var(--ease-out) infinite;
	}
	@keyframes k-chip {
		0% {
			opacity: 0;
			transform: translateY(0.875rem) scale(0.96);
		}
		4%,
		26% {
			opacity: 1;
			transform: none;
		}
		32%,
		100% {
			opacity: 0;
			transform: translateY(-0.625rem);
		}
	}
	@media (max-width: 40em) {
		.chip:nth-of-type(n + 4) {
			display: none;
		}
	}
	.split-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1rem 3rem;
	}
	.split-head > :first-child {
		max-width: 18ch;
	}
	.split-head p {
		max-width: 34ch;
		font-size: 1.125rem;
	}
	.live-band {
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 5vw, 4rem);
	}
	.live-grid {
		display: grid;
		gap: 2rem 3rem;
		align-items: center;
	}
	@media (min-width: 62.5em) {
		.live-grid {
			grid-template-columns: minmax(0, 1fr) 22.5rem;
		}
		.live-grid.casino {
			grid-template-columns: 22.5rem minmax(0, 1fr);
		}
	}
	.live-shots {
		position: relative;
	}
	.live-shots :global(.phone) {
		position: absolute;
		right: -0.75rem;
		bottom: 1.875rem;
		width: clamp(5.625rem, 13vw, 11.25rem);
		aspect-ratio: 9 / 19.5;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		border: 0.3125rem solid #120c0a;
		box-shadow: 0 1.875rem 3.75rem rgb(0 0 0 / 0.45);
	}
	.tilt {
		transform: rotate(-1.5deg);
	}
	.tilt :global(.frame-img) {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: top;
	}
	.more-link {
		font-weight: 700;
		align-self: flex-start;
	}
	.play {
		background: var(--violet);
		color: var(--white);
		display: grid;
		gap: 2.5rem 4rem;
		align-items: start;
	}
	.play a:hover {
		color: var(--violet-mist);
	}
	.play :global(.more summary) {
		align-self: flex-start;
	}
	@media (min-width: 62.5em) {
		.play {
			grid-template-columns: 25rem minmax(0, 1fr);
		}
	}
</style>
