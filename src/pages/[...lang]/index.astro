---
import { existsSync } from 'node:fs';
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import SeriesList from '../../components/SeriesList.astro';
import RaceProof from '../../components/RaceProof.astro';
import Split from '../../components/Split.astro';
import BackendTour from '../../components/islands/BackendTour';
import JobTiles from '../../components/islands/JobTiles';
import ScreenTabs from '../../components/islands/ScreenTabs';
import { LINKS } from '../../consts';
import { caseSlug, stackMain } from '../../data/job';
import { getArticles, getWork } from '../../lib/content';
import Base from '../../layouts/Base.astro';
import { base, dict, langPaths, type Lang } from '../../i18n';
import brad from '../../assets/brad.jpg';
import casinoShot from '../../assets/shots/casino-table.webp';
import bentoShot from '../../assets/shots/reservas-bento.jpg';
import dayShot from '../../assets/shots/reservas-franjas.jpg';
import homeShot from '../../assets/shots/reservas-home.jpg';
import phoneShot from '../../assets/shots/reservas-phone.jpg';

export const getStaticPaths = langPaths;
const lang: Lang = Astro.params.lang === 'es' ? 'es' : 'en';
const t = dict(lang);
const h = t.home;
const b = base(lang);

// Only link to pages that exist in this build: drafts are left out of production.
const published = new Set((await getWork(lang)).map((w) => w.slug));
const hasArticles = (await getArticles(lang)).length > 0;

const shot = async (src: ImageMetadata, label: string, url: string, alt: string) => {
	const img = await getImage({ src, width: 1280, format: 'webp' });
	return { label, url, alt, src: img.src, width: src.width, height: src.height };
};
const screens = await Promise.all([
	shot(homeShot, h.screens.courts.label, 'reservas-web-two.vercel.app', h.screens.courts.alt),
	shot(dayShot, h.screens.day.label, 'reservas-web-two.vercel.app/pistas/7e51…', h.screens.day.alt),
	shot(bentoShot, h.screens.grid.label, 'reservas-web-two.vercel.app', h.screens.grid.alt),
]);

// The CV link appears only once a site version of the PDF sits in public/: the job-search CV
// carries a notice period, a phone number and internal figures the site never shows.
const hasCv = existsSync(`${process.cwd()}/public${LINKS.cv}`);
---

<Base>
	<!-- The person first: who he is and how he works, with his face as the image. The work follows as evidence. -->
	<section class="wrap hero">
		<div class="hero-copy">
			<Split as="h1" text={h.title} class="hero-title" delay={150} />
			<p class="byline" data-a="up" style="--d: 300ms">{h.byline}</p>
			<p class="lede" data-a="up" style="--d: 400ms">{h.lede}</p>
			<p class="hero-meta" data-a="up" style="--d: 520ms">
				<span class="sr-only">{h.everyDay}: </span>{stackMain.join(' · ')}
			</p>
			<div class="row hero-cta" data-a="up" style="--gap: 0.75rem 1.5rem; --d: 560ms">
				<a class="btn btn-primary" href={`mailto:${LINKS.email}`}>{t.common.writeMe}</a>
				<a class="btn btn-ghost" href="#projects">{h.seeWork}</a>
				<ul class="profiles" aria-label={h.profilesLabel}>
					<li><a href={LINKS.github}>GitHub</a></li>
					<li><a href={LINKS.linkedin}>LinkedIn</a></li>
					{hasCv && <li><a href={LINKS.cv} download>{h.cv}</a></li>}
				</ul>
			</div>
		</div>
		<figure class="portrait" data-a="clip" style="--d: 150ms">
			<Image src={brad} alt={h.photoAlt} widths={[360, 600, 900]} sizes="(min-width: 72em) 30rem, (min-width: 60em) 22rem, 62vw" loading="eager" fetchpriority="high" />
		</figure>
	</section>

	<!-- The band itself is solid from the first frame; only what sits on it fades in, and the entrances start just before they scroll into view (Base.astro). -->
	<section id="projects" class="band-dark dark wrap section live-band">
		<div class="split-head">
			<Split text={h.liveTitle} class="display-l home-l" mode="rot" />
			<p class="muted">{h.liveLede}</p>
		</div>
		<div class="live-grid" data-a="up">
			<div class="live-shots">
				<ScreenTabs client:visible screens={screens} tabsLabel={h.screensLabel} />
				<Image src={phoneShot} alt={h.phoneAlt} class="phone" width={180} />
			</div>
			<div class="stack" style="--gap: 1.125rem">
				<h3 class="display-m">reservas</h3>
				<p>{h.reservasDesc}</p>
				<div class="row">
					<a class="btn btn-light" href={LINKS.reservasDemo}>{t.common.openApp}</a>
					{published.has('reservas') && <a class="btn btn-ghost" href={`${b}/work/reservas/`}>{t.common.caseStudy}</a>}
					<a class="more-link" href={LINKS.reservasRepo}>{t.common.code}</a>
				</div>
			</div>
		</div>
		<!-- A second, smaller exhibit: his degree's final project, below the production-shaped one. Its buttons are its only actions; the frame is the picture. -->
		<div class="live-grid casino">
			<div class="stack" data-a="up" style="--gap: 0.875rem">
				<h3 class="casino-title">casino_online</h3>
				<p>{h.casinoDesc}</p>
				<div class="row">
					<a class="btn btn-light" href={LINKS.casinoDemo}>{t.common.openApp}</a>
					<a class="btn btn-ghost" href={LINKS.casinoRepo}>{t.common.code}</a>
				</div>
			</div>
			<div class="frame tilt" data-a="right">
				<div class="frame-bar">
					<span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="frame-url">casino-online-nu.vercel.app</span>
				</div>
				<Image src={casinoShot} alt={h.casinoAlt} width={1280} class="frame-img" />
			</div>
		</div>
	</section>

	<section class="wrap section stack band-white" style="--gap: 2.5rem">
		<!-- Checkable proof right after the apps: the reservas race test, then the tour of one booking. -->
		<div class="proof">
			<!-- The claim and its receipt side by side with the picture: the headline, then what the test is
			     and where to read it. From 80em the column stays beside the panel as it scrolls. -->
			<div class="proof-claim">
				<Split text={h.raceTitle} class="display-l home-l" mode="blur" sentences />
				<p class="proof-note" data-a="up" style="--d: 200ms">{h.raceCaption} <a href={LINKS.raceTest}>{h.raceProof}</a></p>
			</div>
			<RaceProof
				win={h.raceWin}
				lose={h.raceLose}
				winGloss={h.raceWinGloss}
				loseGloss={h.raceLoseGloss}
				start={h.raceStart}
				wall={h.raceWall}
				gets={h.raceGets}
				sr={h.raceSr}
				pause={h.pause}
			/>
		</div>
		<!-- The tour's head stacks above its stops, so it doesn't repeat the split heads around it. -->
		<div class="stack tour-head" style="--gap: 0.75rem">
			<Split text={h.backendTitle} class="display-m" mode="up" />
			<p>{h.backendLede}</p>
		</div>
		<BackendTour client:visible lang={lang} />
	</section>

	<!-- Private work comes after everything a visitor can open or run: described, never shown.
	     The retry game lives in the articles now; the tour's "Sent twice?" stop keeps its lesson. -->
	<section id="job" class="wrap section stack" style="--gap: 1.75rem">
		<div class="split-head">
			<Split text={h.workTitle} class="display-m" mode="up" />
			<p>{h.workLede}</p>
		</div>
		<JobTiles client:visible lang={lang} caseReady={published.has(caseSlug)} />
		<a href={`${b}/about/`} class="btn btn-ghost more-link">{h.everything}</a>
	</section>

	{
		hasArticles && (
			<section id="writing" class="wrap section side">
				<div class="stack" style="--gap: 1rem">
					<Split text={h.writingTitle} class="display-m" mode="rot" />
					<p>{h.writingLede}</p>
					<a href={`${b}/rss.xml`} class="more-link">{t.common.rss}</a>
				</div>
				<SeriesList />
			</section>
		)
	}
</Base>

<style>
	/* The person leads: copy on the left, his portrait as the image on the right. */
	.hero {
		display: grid;
		gap: 2rem clamp(2.5rem, 5vw, 5rem);
		align-items: center;
		padding-block: clamp(0.5rem, 2.5vw, 2rem) clamp(3.5rem, 8vw, 7rem);
	}
	/* Side by side from 60em, with a narrower portrait until 72em so the headline keeps a real column;
	   below 60em the portrait follows the name. */
	@media (min-width: 60em) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
		}
	}
	@media (min-width: 72em) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
		}
	}
	.hero-copy {
		display: flex;
		flex-direction: column;
		gap: clamp(1rem, 2vw, 1.5rem);
	}
	.hero :global(.hero-title) {
		font-weight: 900;
		font-size: clamp(2.25rem, 4.4vw, 4.25rem);
		line-height: 1.02;
		letter-spacing: -0.03em;
		max-width: 16ch;
	}
	.byline {
		margin-top: -0.25rem;
		font-weight: 700;
		font-size: clamp(1.125rem, 1.5vw, 1.25rem);
	}
	.hero .lede {
		max-width: 38rem;
	}
	/* The face carries weight only with an edge: the page ground is the portrait's own backdrop, so
	   the photo sits on an espresso mat, arched like the photo, instead of dissolving into the fog. */
	.portrait {
		margin: 0;
		justify-self: end;
		width: min(100%, 30rem);
		padding: clamp(0.5rem, 1vw, 0.875rem);
		border-radius: 99em 99em var(--radius-lg) var(--radius-lg);
		background: var(--ink);
	}
	.portrait :global(img) {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: top;
		border-radius: 99em 99em calc(var(--radius-lg) - 0.5rem) calc(var(--radius-lg) - 0.5rem);
	}
	/* One column: name, the face, then the rest in reading order (what he does, his stack, how to
	   reach him), so the reason to write comes before the button. The portrait stays small enough
	   that the lede starts above the fold on a phone. */
	@media (max-width: 59.99em) {
		.hero-copy {
			display: contents;
		}
		.hero {
			gap: clamp(1rem, 3vw, 1.5rem);
		}
		.portrait {
			order: 1;
			justify-self: start;
			width: min(62%, 18rem);
			margin-block: 0.25rem;
		}
		.hero-copy > :not(:global(.hero-title), .byline) {
			order: 2;
		}
	}
	.hero-meta {
		font-size: 1rem;
		color: var(--muted);
	}
	.profiles {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-weight: 700;
		font-size: 1rem;
	}
	.profiles a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
	}
	/* The backend band opens with its proof: the claim beside the race test, both from the top edge
	   so the headline doesn't float in the middle of the tall panel. */
	.proof {
		display: grid;
		gap: 2rem clamp(2.5rem, 5vw, 5rem);
		align-items: start;
	}
	/* Side by side only where the headline keeps a real column; below that it sits above the race,
	   which keeps a panel's width instead of stretching into a band-wide wall of stripes. */
	.proof > :global(.race-proof) {
		max-width: 46rem;
	}
	@media (min-width: 80em) {
		.proof {
			grid-template-columns: minmax(0, 1fr) minmax(0, 34rem);
		}
		.proof-claim {
			position: sticky;
			top: 2rem;
		}
	}
	.proof-claim {
		display: flex;
		flex-direction: column;
		gap: clamp(1rem, 2vw, 1.5rem);
	}
	.proof-note {
		max-width: 34ch;
		font-size: 1.125rem;
		color: var(--muted);
	}
	/* A 44px hit area around the inline link, without moving the lines around it. */
	.proof-note a {
		display: inline-block;
		padding-block: 0.75rem;
		margin-block: -0.75rem;
		font-weight: 700;
		color: var(--ink);
		white-space: nowrap;
	}
	/* The home builds from the hero down: the H1 is the largest type on the page, the live apps and
	   the race come next, and the sections after them step down to the medium heading. */
	.live-band :global(.home-l),
	.proof :global(.home-l) {
		font-size: clamp(1.875rem, 3.6vw, 3.25rem);
	}
	.tour-head p {
		max-width: 40ch;
		font-size: 1.125rem;
	}
	.split-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1rem 3rem;
	}
	.split-head > :first-child {
		max-width: 18ch;
	}
	.split-head p {
		max-width: 34ch;
		font-size: 1.125rem;
	}
	/* clip, not hidden: the casino frame slides in from the right without widening a phone's page. */
	.live-band {
		overflow-x: clip;
		display: flex;
		flex-direction: column;
		gap: clamp(3rem, 6vw, 4.5rem);
	}
	.live-grid {
		display: grid;
		gap: 2rem 3rem;
		align-items: center;
	}
	@media (min-width: 62.5em) {
		.live-grid {
			grid-template-columns: minmax(0, 1fr) 22.5rem;
		}
		.live-grid.casino {
			grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
		}
	}
	.live-grid.casino {
		padding-top: clamp(2rem, 4vw, 3rem);
		border-top: 0.0625rem solid var(--line-on-ink);
	}
	.casino-title {
		font-size: clamp(1.125rem, 2vw, 1.375rem);
	}
	.live-grid.casino p {
		max-width: 40ch;
	}
	/* One column: both projects read frame first, then text, so one project's text never runs into the next. */
	@media (max-width: 62.49em) {
		.live-grid.casino > .frame {
			order: -1;
		}
	}
	/* One lead action per project: the app is the button, the code a plain link in the same row,
	   spaced by the row's own gap. */
	.live-grid .more-link {
		font-weight: 700;
	}
	.live-shots {
		position: relative;
	}
	.live-shots :global(.phone) {
		position: absolute;
		right: -0.75rem;
		bottom: 1.875rem;
		width: clamp(5.625rem, 13vw, 11.25rem);
		aspect-ratio: 9 / 19.5;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		border: 0.3125rem solid var(--ink-3);
		box-shadow: 0 1.875rem 3.75rem rgb(0 0 0 / 0.45);
	}
	/* On phones the capture sits inside the screenshot, clear of the tabs below it. */
	@media (max-width: 40em) {
		.live-shots :global(.phone) {
			top: 3.25rem;
			bottom: auto;
			right: -0.5rem;
		}
	}
	.tilt {
		transform: rotate(-1.5deg);
	}
	/* casino-table.webp is the blackjack capture cropped to the table and its controls, 2:1, so every
	   browser shows the same picture without object-view-box. */
	.tilt :global(.frame-img) {
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
	}
	/* The route to his path and training: a real button, not a stray underlined line. */
	.more-link {
		align-self: flex-start;
	}
	/* Fog for the profile, espresso for the live apps, white for the backend proof, fog for his private work. */
	.band-white {
		background: var(--white);
		border-radius: var(--radius-lg) var(--radius-lg) 0 0;
	}
	.band-white + section {
		padding-top: clamp(3.5rem, 8vw, 8rem);
	}
</style>
