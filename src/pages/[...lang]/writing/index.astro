---
import SeriesList from '../../../components/SeriesList.astro';
import Split from '../../../components/Split.astro';
import Base from '../../../layouts/Base.astro';
import { base, dict, langPaths, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;
const lang: Lang = Astro.params.lang === 'es' ? 'es' : 'en';
const t = dict(lang);
---

<Base title={t.home.writingTitle} description={t.home.writingLede}>
	<section class="wrap section side">
		<div class="stack" style="--gap: 1rem">
			<Split as="h1" text={t.home.writingTitle} mode="up" class="display-xl" delay={150} />
			<p data-a="up" style="--d: 300ms">{t.home.writingLede}</p>
			<a href={`${base(lang)}/rss.xml`} class="rss">{t.common.rss}</a>
		</div>
		<SeriesList />
	</section>
</Base>

<style>
	.rss {
		font-weight: 700;
	}
</style>
