---
import { Image } from 'astro:assets';
import Split from '../../components/Split.astro';
import PathTimeline from '../../components/islands/PathTimeline';
import StackLevels from '../../components/islands/StackLevels';
import BioEn from '../../content/about.en.mdx';
import BioEs from '../../content/about.es.mdx';
import { dict, langPaths, type Lang } from '../../i18n';
import Base from '../../layouts/Base.astro';
import brad from '../../assets/brad.jpg';

export const getStaticPaths = langPaths;
const lang: Lang = Astro.params.lang === 'es' ? 'es' : 'en';
const t = dict(lang).about;
const footer = dict(lang).footer;
const Bio = lang === 'es' ? BioEs : BioEn;
const principles = t.principles;
const training = t.training.map(([when, title, who], i) => ({ when, title, who, main: i === 0 }));
---

<Base title={dict(lang).nav.about} description={t.description} footerLead={footer.leadAbout}>
	<section class="wrap about-hero">
		<Image src={brad} alt={dict(lang).home.photoAlt} widths={[360, 460, 720]} sizes="(min-width: 62.5em) 28.75rem, 90vw" loading="eager" fetchpriority="high" class="about-photo" data-a="clip" style="--d: 150ms" />
		<div class="stack" style="--gap: 1.5rem">
			<Split as="h1" text={t.title} mode="chars" class="display-xl" delay={150} />
			<p class="lede" data-a="up" style="--d: 300ms">{t.lede}</p>
			<div class="about-stats" data-stagger>
				{t.stats.map(([v, l]) => <div class="card stat"><strong>{v}</strong><span>{l}</span></div>)}
			</div>
			<details class="more">
				<summary><span class="when-closed">{t.readStory}</span><span class="when-open">{t.hideStory}</span></summary>
				<div class="stack" style="--gap: 0.75rem"><Bio /></div>
			</details>
			<div class="row" style="--gap: 0.5rem">
				{t.langs.map((l) => <span class="pill">{l}</span>)}
			</div>
		</div>
	</section>

	<section class="panel-dark dark stack" style="--gap: 1.75rem" data-a="blur">
		<Split text={t.knowTitle} class="display-m" mode="rot" />
		<StackLevels client:visible lang={lang} />
	</section>

	<section class="wrap section stack" style="--gap: 2rem" data-a="up">
		<Split text={t.pathTitle} class="display-m" mode="up" />
		<PathTimeline client:visible lang={lang} />
	</section>

	<section class="wrap side" data-a="right">
		<Split text={t.howTitle} class="display-m" mode="blur" />
		<div class="principles" data-stagger="up">
			{
				principles.map(([t, d]) => (
					<div class="card stack" style="--gap: 0.5rem">
						<strong class="p-title">{t}</strong>
						<span>{d}</span>
					</div>
				))
			}
		</div>
	</section>

	<section class="wrap section stack" style="--gap: 1.75rem">
		<Split text={t.trainingTitle} class="display-m" mode="chars" />
		<div class="training" data-stagger="drop">
			{
				training.map((t) => (
					<div class:list={['card', 'cert', { main: t.main }]}>
						<span class="tag">{t.when}</span>
						<strong>{t.title}</strong>
						<span class="who">{t.who}</span>
					</div>
				))
			}
		</div>
	</section>
</Base>

<style>
	.about-hero {
		display: grid;
		gap: 2rem 5rem;
		align-items: center;
		padding-block: clamp(1rem, 3vw, 3rem) clamp(3.5rem, 8vw, 7rem);
	}
	@media (min-width: 62.5em) {
		.about-hero {
			grid-template-columns: 28.75rem minmax(0, 1fr);
		}
	}
	.about-hero :global(.about-photo) {
		width: 100%;
		max-width: 28.75rem;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 1.75rem 50% 1.75rem 1.75rem;
	}
	.about-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.625rem;
		max-width: 40rem;
	}
	.principles {
		display: grid;
		gap: 1rem;
	}
	@media (min-width: 47.5em) {
		.principles {
			grid-template-columns: 1fr 1fr;
		}
	}
	.p-title,
	.cert strong {
		font-family: var(--font-display);
		font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
		line-height: 1.25;
	}
	.training {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
	}
	.cert {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		min-height: 11.25rem;
	}
	.cert.main {
		background: var(--ink);
		color: var(--paper);
	}
	.cert.main .tag {
		color: var(--muted-on-ink);
	}
	.who {
		font-size: 0.875rem;
		color: var(--muted);
	}
	.cert.main .who {
		color: var(--white);
	}
</style>
