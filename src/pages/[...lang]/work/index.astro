---
import { Image } from 'astro:assets';
import Split from '../../../components/Split.astro';
import WorkBoard from '../../../components/islands/WorkBoard';
import { caseSlug } from '../../../data/job';
import { LINKS } from '../../../consts';
import casinoShot from '../../../assets/shots/casino-blackjack.webp';
import reservasShot from '../../../assets/shots/reservas-home.jpg';
import Base from '../../../layouts/Base.astro';
import { getWork } from '../../../lib/content';
import { base, dict, langPaths, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;
const lang: Lang = Astro.params.lang === 'es' ? 'es' : 'en';
const t = dict(lang).work;
const work = await getWork(lang);
const projects = work.flatMap((w) => (w.data.kind === 'project' ? [{ slug: w.slug, data: w.data }] : []));
// While a project's case study is still a draft, it is listed anyway with its live demo and its
// code, so this page never promises projects it does not show.
const home = dict(lang).home;
const pending = [
	{ slug: 'reservas', name: 'reservas', desc: home.reservasDesc, shot: reservasShot, demo: LINKS.reservasDemo, repo: LINKS.reservasRepo },
	{ slug: 'casino-online', name: 'casino_online', desc: home.casinoDesc, shot: casinoShot, demo: LINKS.casinoDemo, repo: LINKS.casinoRepo },
].filter((p) => !projects.some((w) => w.slug === p.slug));
---

<Base title={t.title} description={t.lede}>
	<section class="wrap work-head">
		<Split as="h1" text={t.title} mode="chars" class="display-xl" delay={150} />
		<p class="lede" data-a="up" style="--d: 300ms">{t.lede}</p>
	</section>

	{
		projects.length + pending.length > 0 && (
			<section class="panel-dark dark projects" data-stagger="up">
				{projects.map(({ slug, data }) => (
					<a href={`${base(lang)}/work/${slug}/`} class="project">
						<div class="frame">
							<div class="frame-bar">
								<span class="frame-dots" aria-hidden="true">
									<i />
									<i />
									<i />
								</span>
							</div>
							<div class="project-shot">
								<Image src={data.cover} alt="" width={900} />
							</div>
						</div>
						<div class="project-name">
							<span>{data.title}</span>
							<span class="muted">{data.period}</span>
						</div>
						<span class="muted">{data.tagline}</span>
					</a>
				))}
				{pending.map((p) => (
					<div class="project">
						<div class="frame">
							<div class="frame-bar">
								<span class="frame-dots" aria-hidden="true">
									<i />
									<i />
									<i />
								</span>
							</div>
							<div class="project-shot">
								<Image src={p.shot} alt="" width={900} />
							</div>
						</div>
						<div class="project-name">
							<span>{p.name}</span>
						</div>
						<span class="muted">{p.desc}</span>
						<div class="row">
							<a class="btn btn-light" href={p.demo}>{t.demo}</a>
							<a class="btn btn-ghost" href={p.repo}>{t.code}</a>
						</div>
					</div>
				))}
			</section>
		)
	}

	<section class="wrap section stack" style="--gap: 1.75rem" data-a="blur">
		<div class="stack" style="--gap: 0.625rem">
			<Split text={t.atJob} class="display-m" mode="rot" />
			<p class="muted">{t.atJobLede}</p>
		</div>
		<WorkBoard client:visible lang={lang} caseReady={work.some((w) => w.slug === caseSlug)} />
	</section>
</Base>

<style>
	.work-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1rem 3rem;
		padding-block: clamp(1.5rem, 4vw, 4rem) clamp(2rem, 4vw, 3.5rem);
	}
	.projects {
		display: grid;
		gap: 2rem;
	}
	@media (min-width: 56.25em) {
		.projects {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.project {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		text-decoration: none;
	}
	.project-shot {
		overflow: hidden;
		aspect-ratio: 16 / 10;
	}
	.project-shot :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.5s var(--ease-out);
	}
	.project:hover .project-shot :global(img) {
		transform: scale(1.04);
	}
	.project-name {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	.project-name span:first-child {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.375rem, 2.4vw, 2.125rem);
	}
</style>
