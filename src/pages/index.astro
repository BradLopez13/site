---
import ArticleList from '../components/ArticleList.astro';
import WorkList from '../components/WorkList.astro';
import { LINKS } from '../consts';
import Base from '../layouts/Base.astro';
import { getArticles, getWork } from '../lib/content';

const work = (await getWork()).slice(0, 3);
const articles = (await getArticles()).slice(0, 3);
---

<Base>
	{/* TODO(step 3): the one strong sentence comes out of the design direction. */}
	<h1>Brad López</h1>
	<p>Full-stack developer in Madrid. Node.js and TypeScript on the server, React on the client.</p>

	<h2>Selected work</h2>
	<WorkList work={work} />
	<p><a href="/work">All work</a></p>

	<h2>Writing</h2>
	<ArticleList articles={articles} />
	<p><a href="/writing">All articles</a></p>

	<h2>Contact</h2>
	<p>
		<a href={LINKS.linkedin}>LinkedIn</a> · <a href={LINKS.github}>GitHub</a> ·
		<a href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
	</p>
</Base>
