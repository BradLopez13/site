---
import LiveWindow from '../../components/LiveWindow.astro';
import T from '../../components/T.astro';
import Chain from '../../components/islands/Chain';
import { LINKS } from '../../consts';
import en from '../../i18n/en.json';
import Base from '../../layouts/Base.astro';
import shot from '../../assets/shots/casino-blackjack.webp';
---

<Base current="projects" title="Casino Online · Brad López">
	<section class="wrap case-hero">
		<a class="crumb" href="/#mine"><T k="ui.myProjects" /></a>
		<h1 class="disp load text-[clamp(2.2rem,8vw,8.5rem)]">Casino Online</h1>
		<T k="projects.casino.tagline" as="p" class="lede text-[clamp(1.25rem,2vw,1.6rem)] max-w-[34ch]" />
		<dl class="grid grid-cols-1 lg:grid-cols-3 gap-6 pt-6 rule-t-fg [&_dt]:text-[0.9rem] [&_dt]:text-soft [&_dd]:m-0 [&_dd]:mt-1.5 [&_dd]:font-semibold">
			<div><T k="ui.role" as="dt" /><T k="projects.casino.roleCase" as="dd" /></div>
			<div><T k="ui.when" as="dt" /><dd>2025</dd></div>
			<div><T k="ui.stack" as="dt" /><dd>Angular 19, Firebase, Firestore rules</dd></div>
		</dl>
	</section>
	<section class="wrap">
		<LiveWindow url={LINKS.casinoDemo} name="Casino Online" shot={shot} altKey="projects.casino.altCase" titleKey="projects.casino.liveTitle" noteKey="projects.casino.noteCase" />
	</section>
	<section class="wrap case-block mt-12">
		<div><T k="cases.casinoWhat" as="h2" class="disp h-m" data-split /></div>
		<div class="prose">
			<T k="cases.casinoText" as="p" />
			<T k="cases.casinoHold" as="p" />
			<Chain nodes={en.cases.diagramCasino} label={en.cases.diagramCasinoA} me={[1]} keyBase="cases.diagramCasino" draw />
			<p class="links mt-6"><a href={LINKS.casinoRepo}><T k="ui.code" /></a></p>
		</div>
	</section>
</Base>
