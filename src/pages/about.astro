---
import { Image } from 'astro:assets';
import Experience from '../components/Experience.astro';
import HowIWork from '../components/HowIWork.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
import { LINKS } from '../consts';
import { tip } from '../i18n';
import Base from '../layouts/Base.astro';
import brad from '../assets/brad.jpg';
---

<Base current="about" titleKey="meta.aboutTitle" footerKey="footer.leadAbout">
	<section class="wrap hero">
		<T k="about.title" as="h1" class="disp load" />
		<figure class="hero-photo" data-after-load>
			<Image src={brad} alt="Brad López" widths={[400, 700, 1000]} sizes="(min-width: 60em) 28rem, 72vw" loading="eager" />
		</figure>
		<div class="hero-meta" data-after-load>
			<T k="about.lede" as="p" class="lede m-0 max-w-[52ch]" />
			<T k="about.security" as="p" class="lede muted m-0 max-w-[52ch]" />
			<div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-2"><a class="btn btn-ink" {...tip('tips.writeMe')} href={`mailto:${LINKS.email}`}><Icon name="envelope" /><T k="ui.writeMe" /></a></div>
		</div>
	</section>
	<section class="section pt-0">
		<div class="wrap">
			<div class="head"><T k="home.howTitle" as="h2" class="disp h-l" data-split /></div>
			<HowIWork />
		</div>
	</section>
	<section class="section pt-0">
		<div class="wrap grid grid-cols-1 xl:grid-cols-2 gap-x-[clamp(2rem,5vw,5rem)] gap-y-12 *:min-w-0">
			<div><T k="home.expTitle" as="h2" class="disp h-m" data-split /><div class="mt-6"><Experience which="experience" /></div></div>
			<div><T k="home.eduTitle" as="h2" class="disp h-m" data-split /><div class="mt-6"><Experience which="education" /></div></div>
		</div>
	</section>
	<section class="section pt-0">
		<div class="wrap">
			<div class="head">
				<T k="about.knowTitle" as="h2" class="disp h-m" data-split />
				<T k="about.knowLede" as="p" class="muted m-0 max-w-[56ch]" />
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-x-12 gap-y-8 *:min-w-0">
				<div><T k="about.prod" as="b" class="disp h-s" /><p class="muted">TypeScript, React, Node.js, Express, REST APIs, MongoDB, Cosmos DB, Azure Storage, GitHub Actions, Docker, Jest, ESLint.</p></div>
				<div><T k="about.own" as="b" class="disp h-s" /><p class="muted">Fastify, PostgreSQL, Drizzle, Zod, Vitest, Testcontainers, Playwright, Angular 19, Firebase, Supabase, Expo.</p></div>
				<div><T k="about.before" as="b" class="disp h-s" /><p class="muted">Java, Python, PHP, MySQL, Power BI, Android Studio.</p></div>
			</div>
		</div>
	</section>
</Base>
