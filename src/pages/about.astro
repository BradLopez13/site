---
import { Image } from 'astro:assets';
import Split from '../components/Split.astro';
import PathTimeline from '../components/islands/PathTimeline';
import StackLevels from '../components/islands/StackLevels';
import Bio from '../content/about.mdx';
import Base from '../layouts/Base.astro';
import brad from '../assets/brad.jpg';

const principles = [
	['Decisions before code', 'Short decision records: the problem, the options, why this one.'],
	['Rules the tools enforce', 'If a convention matters, a linter or a CI check holds it, not a wiki page.'],
	['Test against the real thing', 'Concurrency against a real database, flows in a real browser.'],
	['AI-assisted, human-owned', 'I design and decide; AI helps implement. Nothing merges without review and green tests.'],
];

const training = [
	{ when: '2024 to 2026', title: 'Postgraduate in Cybersecurity and Offensive Security', who: 'EIP International Business School', main: true },
	{ when: '2026', title: 'Certified Cyber Security Professional', who: 'ISMS Forum' },
	{ when: '2025', title: 'IT Specialist, Network Security', who: 'Certiport' },
	{ when: '2026', title: 'Introduction to Financial Accounting', who: 'IESE Business School' },
	{ when: '2025', title: 'Leadership', who: 'Harvard Business Impact' },
];
---

<Base title="About" description="Who I am, what I know and how well, and the path so far." footerLead="Looking for a backend or full-stack developer? I can start with 15 days’ notice.">
	<section class="wrap about-hero">
		<Image src={brad} alt="Brad López" widths={[360, 460, 720]} sizes="(min-width: 62.5em) 28.75rem, 90vw" loading="eager" fetchpriority="high" class="about-photo" data-a="clip" style="--d: 150ms" />
		<div class="stack" style="--gap: 1.5rem">
			<Split as="h1" text="Hi, I’m Brad." mode="chars" class="display-xl" delay={150} />
			<p class="lede" data-a="up" style="--d: 300ms">Full-stack developer in Madrid. I like the parts nobody sees until they break.</p>
			<div class="about-stats" data-stagger>
				<div class="card stat"><strong>2 yrs</strong><span>in production</span></div>
				<div class="card stat"><strong>3 mo</strong><span>junior to full-stack</span></div>
				<div class="card stat"><strong>2 to 6</strong><span>devs on my standard</span></div>
			</div>
			<details class="more">
				<summary><span class="when-closed">Read my story</span><span class="when-open">Hide my story</span></summary>
				<div class="stack" style="--gap: 0.75rem"><Bio /></div>
			</details>
			<div class="row" style="--gap: 0.5rem">
				<span class="pill">Spanish, native</span>
				<span class="pill">English B2, TOEIC certified</span>
				<span class="pill">EU citizen</span>
			</div>
		</div>
	</section>

	<section class="panel-dark dark stack" style="--gap: 1.75rem" data-a="blur">
		<Split text="What I know, and how well" class="display-m" mode="rot" />
		<StackLevels client:visible />
	</section>

	<section class="wrap section stack" style="--gap: 2rem" data-a="up">
		<Split text="The path so far" class="display-m" mode="up" />
		<PathTimeline client:visible />
	</section>

	<section class="wrap side" data-a="right">
		<Split text="How I work" class="display-m" mode="blur" />
		<div class="principles" data-stagger="up">
			{
				principles.map(([t, d]) => (
					<div class="card stack" style="--gap: 0.5rem">
						<strong class="p-title">{t}</strong>
						<span>{d}</span>
					</div>
				))
			}
		</div>
	</section>

	<section class="wrap section stack" style="--gap: 1.75rem">
		<Split text="Training" class="display-m" mode="chars" />
		<div class="training" data-stagger="drop">
			{
				training.map((t) => (
					<div class:list={['card', 'cert', { main: t.main }]}>
						<span class="tag">{t.when}</span>
						<strong>{t.title}</strong>
						<span class="who">{t.who}</span>
					</div>
				))
			}
		</div>
	</section>
</Base>

<style>
	.about-hero {
		display: grid;
		gap: 2rem 5rem;
		align-items: center;
		padding-block: clamp(1rem, 3vw, 3rem) clamp(3.5rem, 8vw, 7rem);
	}
	@media (min-width: 62.5em) {
		.about-hero {
			grid-template-columns: 28.75rem minmax(0, 1fr);
		}
	}
	.about-hero :global(.about-photo) {
		width: 100%;
		max-width: 28.75rem;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 1.75rem 50% 1.75rem 1.75rem;
	}
	.about-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.625rem;
		max-width: 40rem;
	}
	.principles {
		display: grid;
		gap: 1rem;
	}
	@media (min-width: 47.5em) {
		.principles {
			grid-template-columns: 1fr 1fr;
		}
	}
	.p-title,
	.cert strong {
		font-family: var(--font-display);
		font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
		line-height: 1.25;
	}
	.training {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
	}
	.cert {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		min-height: 11.25rem;
	}
	.cert.main {
		background: var(--violet);
		color: var(--white);
	}
	.cert.main .tag {
		color: var(--violet-mist);
	}
	.who {
		font-size: 0.875rem;
		color: var(--muted);
	}
	.cert.main .who {
		color: var(--white);
	}
</style>
